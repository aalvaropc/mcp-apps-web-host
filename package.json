{
  "name": "mcp-apps-web-host",
  "version": "1.3.1",
  "description": "Dependency-free MCP Apps host for web pages, with a sandbox proxy on a second origin.",
  "type": "module",
  "main": "src/host.js",
  "types": "types/host.d.ts",
  "exports": {
    ".": { "types": "./types/host.d.ts", "default": "./src/host.js" },
    "./sandbox.html": "./sandbox/sandbox.html",
    "./package.json": "./package.json"
  },
  "files": ["src", "sandbox", "types", "README.md", "LICENSE", "CHANGELOG.md", "CONTRIBUTING.md"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check-types": "tsc --noEmit --strict --module esnext --moduleResolution bundler --target es2022 test/types.check.ts",
    "example": "node example/server.mjs",
    "test:browser": "playwright test",
    "test:package": "node test/consumer.mjs"
  },
  "keywords": ["mcp", "mcp-apps", "model-context-protocol", "sandbox", "iframe", "postmessage"],
  "author": "Alvaro Peña (https://github.com/aalvaropc)",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/aalvaropc/mcp-apps-web-host.git" },
  "homepage": "https://github.com/aalvaropc/mcp-apps-web-host#readme",
  "bugs": { "url": "https://github.com/aalvaropc/mcp-apps-web-host/issues" },
  "engines": { "node": ">=18" },
  "devDependencies": { "@playwright/test": "1.62.0", "typescript": "5.9.3" }
}
